# Postgres (lokálně / Supabase / Neon)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/profispojky
# Náhodný řetězec min. 32 znaků
PAYLOAD_SECRET=
# Veřejná URL webu (náhledy, sitemap)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Vercel Blob – povinné na Vercelu (read-only filesystem), lokálně se ukládá do /media
BLOB_READ_WRITE_TOKEN=
# Secret pro Vercel Cron (plánované publikování aktualit)
CRON_SECRET=
# Indexování vyhledávači: "true" až po spuštění ostré domény
ALLOW_INDEXING=false
