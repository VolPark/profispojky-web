# Postgres – lokálně z docker-compose.yml; v produkci jen jiná hodnota, kód je DB-agnostický
DATABASE_URL=postgres://payload:payload@localhost:5432/profispojky
# Náhodný řetězec min. 32 znaků
PAYLOAD_SECRET=
# Veřejná URL webu (náhledy, sitemap)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Vercel Blob – povinné na Vercelu (read-only filesystem), lokálně se ukládá do /media
BLOB_READ_WRITE_TOKEN=
# Indexování vyhledávači: "true" až po spuštění ostré domény
ALLOW_INDEXING=false
# Upozornění na chyby (e-mail s vysokou prioritou přes Resend). Bez nich se chyby jen logují.
RESEND_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM="Monitoring webu PROFI SPOJKY <asistent@ai.sebit.cz>"
